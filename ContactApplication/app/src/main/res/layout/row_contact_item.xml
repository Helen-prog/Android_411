<ru.rambler.libs.swipe_layout.SwipeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardElevation="5dp"
    android:id="@+id/parentLayout"
    app:cardUseCompatPadding="true">

    <RelativeLayout
        android:id="@+id/mainLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorSecondary"
        android:padding="10dp">

        <!-- круглая кнопка для изображения профиля -->
        <ImageView
            android:id="@+id/contact_image"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="center"
            android:adjustViewBounds="false"
            android:background="@drawable/circular"
            android:src="@drawable/baseline_person_24" />

        <TextView
            android:id="@+id/contact_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_marginStart="16dp"
            android:layout_toStartOf="@id/contact_number_dial"
            android:layout_toEndOf="@id/contact_image"
            android:text="Contact Name"
            android:textColor="@color/colorTextPrimary"
            android:textSize="20sp" />

        <ImageView
            android:id="@+id/contact_number_dial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerInParent="true"
            android:layout_marginEnd="16dp"
            app:srcCompat="@drawable/baseline_local_phone_24"
            app:tint="@color/colorTextPrimary" />
    </RelativeLayout>

    <!--RIGHT-->
    <LinearLayout
        android:layout_width="180dp"
        android:layout_height="match_parent"
        app:bring_to_clamp="150dp"
        app:clamp="self"
        app:gravity="right"
        app:sticky="100dp">

        <ImageView
            android:id="@+id/drag_item"
            android:layout_width="90dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:background="@color/colorTextPrimary"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:src="@drawable/baseline_edit_24" />

        <ImageView
            android:id="@+id/right_view"
            android:layout_width="90dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:background="@color/colorThemeExtra"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:src="@drawable/baseline_delete_forever_24" />


